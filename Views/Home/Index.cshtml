@{
    ViewBag.Title = "Home Page";
}

@if (User.Identity.IsAuthenticated)
{
    <h2>Dear user, Welcome to system!</h2>
}
else { 
    <h2>Welcome to visit, if you wish to use more fuctions, please login.</h2>
}

<img src="~/Image/下载.jpg"  width="567"/>
<img src="~/Image/300px-Mondial_Ping_-_Men's_Singles_-_Round_4_-_Kenta_Matsudaira-Vladimir_Samsonov_-_57.jpg" width="567"/>

<div class="jumbotron">
    <h1>Table Tennis Course Management System</h1>
    <p class="lead">Here you can learn about the locations of various table tennis courses and ongoing matches</p>
    <p><a href="https://en.wikipedia.org/wiki/Table_tennis" class="btn btn-primary btn-lg">Learn more &raquo;</a></p>
</div>

<div class="row">
    <div class="col-md-4">
        <h2>Choose a lecture</h2>

        <img src="~/Image/lecture.jpg" height="250" width="300"/>

        <p>
            The company covers courses from all age groups and beginners, beginners, intermediate, 
            advanced and professional levels. Whether you want to have fun, improve your strength, 
            or engage in passionate competitions, we can meet your various needs ! What are you 
            waiting for? Come choose a lecture!
        </p>
        <p><a class="btn btn-default" href="https://localhost:44374/Lectures/Index">Learn more &raquo;</a></p>
    </div>

    <div class="col-md-4">
        <h2>Choose a tutor</h2>

        <img src="~/Image/tutor.jpg" height="250" width="300" />

        <p>
            Our tutors have won various competitions, and there are even national retired
            coaches! We have the best table tennis tutors in Australia! Don't hesitate, choose
            the tutors you like!
        </p>

        <p><a class="btn btn-default" href="https://localhost:44374/Tutors/Index">Learn more &raquo;</a></p>
    </div>

    <div class="col-md-4">
        <h2>Table Tennis Competition</h2>
        <img src="~/Image/location.jpg" height="250" width="300"/>
        <p>If you want to watch the exciting table tennis match that is going on, 
        come here to check the venue of the match!</p>
        <p><a class="btn btn-default" href="https://localhost:44374/Locations/Index">Learn more &raquo;</a></p>
    </div>
</div>

